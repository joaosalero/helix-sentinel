HELIX_ENVIRONMENT=local
HELIX_APP_NAME=Helix Sentinel
HELIX_API_PREFIX=/api/v1
HELIX_LOG_LEVEL=INFO
HELIX_SECRET_KEY=change-me-use-a-generated-32-byte-secret
HELIX_AUTH_SECRET_KEY=change-me-use-a-generated-32-byte-access-token-secret
HELIX_AUTH_REFRESH_SECRET_KEY=change-me-use-a-generated-32-byte-refresh-token-secret
HELIX_ACCESS_TOKEN_EXPIRE_MINUTES=30
HELIX_REFRESH_TOKEN_EXPIRE_DAYS=14
HELIX_JWT_ISSUER=helix-sentinel
HELIX_JWT_AUDIENCE=helix-sentinel-api
HELIX_DATABASE_URL=postgresql+asyncpg://helix:helix@localhost:5432/helix_sentinel
HELIX_REDIS_URL=redis://localhost:6379/0
HELIX_ALLOWED_ORIGINS=http://localhost:3000
HELIX_OTEL_ENABLED=false
HELIX_PROMETHEUS_ENABLED=true
HELIX_EVENT_INGEST_MAX_BODY_BYTES=262144
